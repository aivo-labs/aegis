# =============================================================================
# AEGIS BY AIVO — VARIABLES D'ENVIRONNEMENT DOKPLOY / PRODUCTION (.env)
# =============================================================================
# Copiez ce fichier en tant que variables d'environnement dans l'interface Dokploy
# pour le service "aegis".
# =============================================================================

# -----------------------------------------------------------------------------
# 1. BASE DE DONNÉES TIMESCALEDB (PERSISTENCE & TÉLÉMÉTRIE TEMPORELLE)
# -----------------------------------------------------------------------------
POSTGRES_DB=aegis_db
POSTGRES_USER=aegis_user
# ⚠️ Remplacez par un mot de passe fort aléatoire en production (ex: openssl rand -base64 24)
POSTGRES_PASSWORD=change_this_to_a_strong_password_in_prod

# -----------------------------------------------------------------------------
# 2. BACKEND API CONTROL PLANE (GO RUNTIME SOUVERAIN)
# -----------------------------------------------------------------------------
APP_ENV=prod
# Clé secrète applicative pour la signature de jetons internes (32 octets hex)
# Générer avec : openssl rand -hex 32
APP_SECRET=4f88631b14a9a08990b7e452a32bf90123456789abcdef0123456789abcdef

# -----------------------------------------------------------------------------
# 3. PASSERELLE INGRESS PEP & WAF (PORT 8000 & PURE BFF TOKEN HANDLER)
# -----------------------------------------------------------------------------
GATE_PORT=8000
AEGIS_TENANT_ID=00000000-0000-0000-0000-000000000001

# ⚠️ Clé de chiffrement AES-256-GCM du cookie de session BFF (32 caractères min)
# Ne JAMAIS déployer avec la clé par défaut.
# Générer avec : openssl rand -base64 32
BFF_SESSION_SECRET=aegis_sovereign_session_secret_32b_key!change_me

# Contrôle du trafic Ingress WAF
AEGIS_MAX_PAYLOAD_BYTES=32768
AEGIS_PROTECTION_ENABLED=true

# -----------------------------------------------------------------------------
# 4. INTÉGRATION KEYCLOAK / OIDC (OPTIONNEL)
# -----------------------------------------------------------------------------
# Si ces variables sont laissées VIDES, le Cockpit fonctionne en mode souverain local
# (session Administrateur SOC native, immédiate, 100% autonome sans SSO).
# Si configurées avec votre instance Keycloak, la connexion bascule en OIDC / PKCE.
OIDC_ISSUER_URL=https://auth.aivo.fr/realms/aegis
OIDC_CLIENT_ID=aegis-cockpit
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://aegis.aivo.fr/api/auth/callback
