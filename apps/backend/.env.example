# Aegis Backend Control Plane Environment Configuration

APP_ENV=prod
APP_SECRET=aegis_super_secret_app_key_2026_aivo

# Database Connection (TimescaleDB / PostgreSQL 16)
DATABASE_URL="postgresql://aegis_user:aegis_password_dev_2026@localhost:5432/aegis_db?serverVersion=16&charset=utf8"

# Redis Cache & Queues
REDIS_URL="redis://localhost:6379"

# Keycloak v26 OIDC IAM Configuration
KEYCLOAK_BASE_URL="https://auth.aivo.fr"
KEYCLOAK_REALM="AIVO"
KEYCLOAK_CLIENT_ID="aegis-backend-service"
KEYCLOAK_CLIENT_SECRET="change_me_in_production"
KEYCLOAK_JWKS_URL="https://auth.aivo.fr/realms/AIVO/protocol/openid-connect/certs"

# API RTE Data Portal (EcoWatt Carbon-Awareness - OAuth2)
RTE_CLIENT_ID=""
RTE_CLIENT_SECRET=""

# Cloudflare Turnstile Captcha Anti-Bot
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# n8n Webhook & Stalwart Mailer Integration
N8N_PASSIVE_SCAN_WEBHOOK_URL="http://localhost:5678/webhook/aegis-passive-scan"
STALWART_SMTP_HOST="smtp.aivo.fr"
STALWART_SMTP_PORT=587
STALWART_SMTP_USER="noreply@aivo.fr"
STALWART_SMTP_PASS="change_me_in_production"
