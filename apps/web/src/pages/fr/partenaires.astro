---
import Layout from '../../layouts/Layout.astro';
import AegisLogo from '../../components/AegisLogo.astro';
---

<Layout 
  title="Devenir Partenaire • Programme Design Partner & Emergency Security Setup | Aegis"
  description="Rejoignez le Programme Design Partner d'Aegis ou sollicitez un Emergency Security Audit & Aegis Setup pour sécuriser votre SI sans alourdir votre infrastructure."
  lang="fr"
>
  <main class="flex-grow py-16 md:py-24 relative overflow-hidden">
    <!-- Grille et halos subtils -->
    <div class="absolute inset-0 bg-[linear-gradient(to_right,#10b9810a_1px,transparent_1px),linear-gradient(to_bottom,#10b9810a_1px,transparent_1px)] bg-[size:36px_36px] pointer-events-none"></div>
    <div class="absolute top-16 left-1/2 -translate-x-1/2 w-[650px] h-[300px] bg-gradient-to-tr from-emerald-500/10 via-teal-400/10 to-transparent blur-3xl pointer-events-none rounded-full"></div>

    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-16">
      
      <!-- 1. EN-TÊTE DE LA PAGE PARTENAIRES -->
      <div class="max-w-3xl mx-auto text-center space-y-5">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-emerald-500/30 text-xs font-mono text-emerald-300">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>PROGRAMME PARTENAIRES &amp; INTERVENTION D'EXPERTISE</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold text-white tracking-tight leading-[1.15]">
          Sécurisez votre SI aux côtés des <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-teal-300 to-cyan-400">architectes d'Aegis</span>.
        </h1>

        <p class="text-base sm:text-lg text-slate-300 leading-relaxed">
          Que vous souhaitiez co-construire l'avenir de la cybersécurité frugale via notre programme <strong>Design Partner</strong>, déléguer votre <strong>Setup Accompagné &amp; MCO</strong> ou déclencher une <strong>Remise en Service &amp; Analyse de Cause Racine (RCA)</strong>, nos ingénieurs vous accompagnent de la <strong>TPE (site vitrine, VPS)</strong> jusqu'aux <strong>Grands Comptes (clusters Kubernetes, Multi-Cloud)</strong>.
        </p>
      </div>

      <!-- 2. LES DEUX VOLETS D'ACCOMPAGNEMENT (SANS TARIF AFFICHÉ, OUVERTS À L'INTERNATIONAL) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
        
        <!-- VOLET 1 : PROGRAMME "DESIGN PARTNER" -->
        <div class="p-8 rounded-3xl bg-slate-900/85 border border-emerald-500/40 backdrop-blur-xl flex flex-col justify-between shadow-2xl relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-400 to-teal-400"></div>
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                Co-Ingénierie &amp; Bêta Accompagnée B2B
              </span>
              <span class="text-xs font-mono text-slate-400">Hébergeurs • SaaS • PME/ETI</span>
            </div>

            <div>
              <h2 class="text-2xl font-extrabold text-white">Programme "Design Partner"</h2>
              <p class="text-sm text-slate-300 mt-2 leading-relaxed">
                Conçu pour les hébergeurs souverains (OVHcloud, Scaleway...), éditeurs SaaS, PME/ETI et équipes DevSecOps souhaitant déployer Aegis en production avec un accompagnement sur-mesure et influencer directement la Roadmap Open-Source.
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 space-y-3 text-xs font-mono text-slate-300">
              <div class="text-emerald-300 font-bold uppercase tracking-wider">Ce qui est inclus dans le partenariat :</div>
              <ul class="space-y-2.5">
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>Déploiement assisté de bout en bout</strong> sur vos environnements Linux, Docker ou clusters Kubernetes.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>Calibrage personnalisé</strong> du WAF Ingress (&lt; 1.5 ms) et du Sinkhole Egress DNS/TCP sur vos flux métiers (zéro faux positif).</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>Mise en place de la sonde matérielle RAPL / Kepler</strong> et génération de vos premiers rapports EcoIndex v3 &amp; conformité.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span><strong>Canal de communication direct</strong> avec l'équipe cœur et priorisation de vos besoins fonctionnels.</span>
                </li>
              </ul>
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-slate-800">
            <a 
              href="#contact-partenaire" 
              onclick="selectPartnerProgram('DESIGN_PARTNER')"
              class="w-full py-3.5 px-5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 font-extrabold text-xs font-mono flex items-center justify-center gap-2 transition-all shadow-lg shadow-emerald-500/20"
            >
              <span>Candidater au Programme Design Partner</span>
              <span>➔</span>
            </a>
          </div>
        </div>

        <!-- VOLET 2 : SETUP ACCOMPAGNÉ, MCO & REMISE EN SERVICE RCA -->
        <div class="p-8 rounded-3xl bg-slate-900/85 border border-cyan-500/40 backdrop-blur-xl flex flex-col justify-between shadow-2xl relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-cyan-400 to-emerald-400"></div>
          <div class="space-y-5">
            <div class="flex items-center justify-between">
              <span class="px-3 py-1 rounded-full text-xs font-mono font-bold bg-cyan-500/15 text-cyan-300 border border-cyan-500/30">
                ⚡ Prise en charge &lt; 24h ouvrées • Créneaux maîtrisés
              </span>
              <span class="text-xs font-mono text-slate-400">De la TPE au Cluster K8s</span>
            </div>

            <div>
              <h2 class="text-2xl font-extrabold text-white">Setup Accompagné, MCO &amp; Remise en Service RCA</h2>
              <p class="text-sm text-slate-300 mt-2 leading-relaxed">
                Un accompagnement d'expertise adapté à votre taille (du simple site vitrine/VPS de TPE jusqu'à l'infrastructure critique) : remise en fonction, investigation de cause racine (RCA), durcissement et Maintien en Condition Opérationnelle (MCO).
              </p>
            </div>

            <div class="p-4 rounded-2xl bg-slate-950/80 border border-slate-800 space-y-3 text-xs font-mono text-slate-300">
              <div class="text-cyan-300 font-bold uppercase tracking-wider">Nos 3 modes d'intervention :</div>
              <ul class="space-y-2.5">
                <li class="flex items-start gap-2.5">
                  <span class="text-cyan-400 font-bold">⚡</span>
                  <span><strong>Remise en Service &amp; Analyse de Cause Racine (RCA)</strong> : Neutralisation des vecteurs d'intrusion (RCE, PHP2Shell, C2), nettoyage et rapport forensique.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-cyan-400 font-bold">⚡</span>
                  <span><strong>Setup Accompagné Clé-en-Main</strong> : Installation sans coupure sur votre VPS, serveur dédié, Docker ou Kubernetes (OVHcloud, Scaleway, Hetzner, Oracle, AWS...).</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-cyan-400 font-bold">⚡</span>
                  <span><strong>MCO &amp; Supervision Continue</strong> : Bouclier autonome actif 24/7 + suivi ingénieur proactif en heures ouvrées, règles Virtual Patching et bilans carbone RAPL.</span>
                </li>
                <li class="flex items-start gap-2.5">
                  <span class="text-cyan-400 font-bold">⚡</span>
                  <span><strong>Tarification juste &amp; Mandat NDA</strong> : Adaptée à la taille réelle de votre structure (forfait TPE accessible ou contrat entreprise sur-mesure).</span>
                </li>
              </ul>
            </div>
          </div>

          <div class="pt-6 mt-6 border-t border-slate-800">
            <a 
              href="#contact-partenaire" 
              onclick="selectPartnerProgram('EMERGENCY_AUDIT_SETUP')"
              class="w-full py-3.5 px-5 rounded-xl bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-extrabold text-xs font-mono flex items-center justify-center gap-2 transition-all shadow-lg shadow-cyan-500/20"
            >
              <span>Demander un Setup, MCO ou Remise en Service</span>
              <span>➔</span>
            </a>
          </div>
        </div>

      </div>

      <!-- 3. FORMULAIRE DE PRISE DE CONTACT (CONNECTÉ À L'API CENTRE DE CONTRÔLE AIVO) -->
      <div id="contact-partenaire" class="max-w-3xl mx-auto p-8 sm:p-10 rounded-3xl bg-slate-900/90 border border-slate-800 shadow-2xl backdrop-blur-xl">
        <div class="flex items-center gap-3 mb-6">
          <AegisLogo size="md" />
          <div>
            <h3 class="text-xl font-extrabold text-white">Contacter l'équipe Aegis</h3>
            <p class="text-xs text-slate-400 font-mono">
              Votre demande est transmise directement à notre Centre de Contrôle pour une prise en charge sous 24h ouvrées.
            </p>
          </div>
        </div>

        <form id="aivo-partner-form" class="space-y-4 font-mono text-xs" onsubmit="event.preventDefault(); submitPartnerContact();">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-slate-300 mb-1.5 font-semibold">Programme souhaité</label>
              <select id="partner-program" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:border-emerald-400 focus:outline-none">
                <option value="DESIGN_PARTNER">Programme "Design Partner" (Co-Ingénierie / Hébergeurs / SaaS)</option>
                <option value="EMERGENCY_AUDIT_SETUP">Urgence : Remise en Service, Correctif &amp; Analyse Cause Racine (RCA)</option>
                <option value="SETUP_MCO">Setup Accompagné &amp; MCO (TPE site vitrine, PME ou Kubernetes)</option>
                <option value="GENERAL_PARTNERSHIP">Autre demande d'accompagnement / Intégration</option>
              </select>
            </div>
            <div>
              <label class="block text-slate-300 mb-1.5 font-semibold">Domaine ou Périmètre cible</label>
              <input type="text" id="partner-domain" required placeholder="mon-entreprise.com" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:border-emerald-400 focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-slate-300 mb-1.5 font-semibold">Nom &amp; Prénom</label>
              <input type="text" id="partner-name" required placeholder="Jean Dupont" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:border-emerald-400 focus:outline-none" />
            </div>
            <div>
              <label class="block text-slate-300 mb-1.5 font-semibold">Email professionnel</label>
              <input type="email" id="partner-email" required placeholder="j.dupont@entreprise.com" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:border-emerald-400 focus:outline-none" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-slate-300 mb-1.5 font-semibold">Société / Organisation</label>
              <input type="text" id="partner-company" placeholder="Entreprise SAS" class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:border-emerald-400 focus:outline-none" />
            </div>
            <div>
              <label class="block text-slate-300 mb-1.5 font-semibold">Infrastructure actuelle</label>
              <input type="text" id="partner-infra" placeholder="VPS Linux, Kubernetes, AWS, Scaleway..." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:border-emerald-400 focus:outline-none" />
            </div>
          </div>

          <div>
            <label class="block text-slate-300 mb-1.5 font-semibold">Contexte &amp; Objectifs</label>
            <textarea id="partner-message" rows="3" required placeholder="Décrivez brièvement votre architecture et vos attentes..." class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950 border border-slate-700 text-white focus:border-emerald-400 focus:outline-none"></textarea>
          </div>

          <button type="submit" id="partner-submit-btn" class="w-full py-3.5 px-6 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-400 hover:from-emerald-400 hover:to-teal-300 text-slate-950 font-extrabold text-sm transition-all cursor-pointer shadow-lg shadow-emerald-500/20">
            Envoyer ma demande d'accompagnement ➔
          </button>
        </form>

        <!-- Confirmation d'envoi API Centre de Contrôle AIVO -->
        <div id="partner-confirm-box" class="hidden mt-5 p-4 rounded-2xl bg-emerald-950/60 border border-emerald-500/40 text-xs font-mono text-emerald-200 space-y-2">
          <div class="font-bold text-emerald-300">✓ Dossier de partenariat préparé et transmis au Centre de Contrôle AIVO</div>
          <p class="text-slate-300 text-[11px]">
            Votre demande a bien été structurée pour notre API de gestion. Un architecte Aegis reviendra vers vous très rapidement.
          </p>
        </div>
      </div>

    </div>
  </main>

  <script is:inline>
    function selectPartnerProgram(val) {
      const sel = document.getElementById('partner-program');
      if (sel) sel.value = val;
    }

    async function submitPartnerContact() {
      const btn = document.getElementById('partner-submit-btn');
      const confirmBox = document.getElementById('partner-confirm-box');
      const payload = {
        schema_version: '1.0',
        product: 'AEGIS_CYBER_GREEN',
        submitted_at_utc: new Date().toISOString(),
        source: 'aegis_partner_page',
        offer_type: document.getElementById('partner-program').value,
        prospect: {
          full_name: document.getElementById('partner-name').value,
          email: document.getElementById('partner-email').value,
          company: document.getElementById('partner-company').value,
          domain: document.getElementById('partner-domain').value,
          infrastructure: document.getElementById('partner-infra').value,
          message: document.getElementById('partner-message').value,
        },
        full_audit_report: null
      };

      window.__lastAivoLeadPayload = payload;
      btn.disabled = true;
      btn.innerText = 'Transmission au Centre de Contrôle AIVO...';

      try {
        await fetch('/api/leads', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
      } catch (e) {
        // Envoi au relais API local ou fallback
      } finally {
        btn.disabled = false;
        btn.innerText = '✓ Demande transmise';
        confirmBox.classList.remove('hidden');
      }
    }
  </script>
</Layout>
