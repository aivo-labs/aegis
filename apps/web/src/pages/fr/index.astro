---
import Layout from '../../layouts/Layout.astro';
import AegisLogo from '../../components/AegisLogo.astro';
---

<Layout 
  title="Aegis Community Edition • Cybersécurité Souveraine & Sobriété Numérique"
  description="Suite open-source de cybersécurité souveraine : Ingress WAF Zero-Trust (< 1.5 ms), blocage d'exfiltration DNS par IA locale Nimble 9B et télémétrie matérielle RAPL Joules/Watts sous licence AGPLv3."
  lang="fr"
>
  <main class="flex-grow flex flex-col font-sans text-slate-100">

    <!-- HERO SECTION SOUVERAINE -->
    <section class="relative pt-12 pb-16 sm:pt-20 sm:pb-24 border-b border-slate-800/70">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        
        <!-- Badge Open Source Souverain -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 font-mono text-xs font-semibold uppercase tracking-wider mb-6">
          <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
          <span>AEGIS COMMUNITY EDITION • OPEN SOURCE AGPLv3</span>
        </div>

        <!-- Titre Principal -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white max-w-4xl mx-auto leading-tight mb-5">
          Cybersécurité Souveraine &amp; <span class="text-emerald-400">Sobriété Matérielle</span>
        </h1>

        <!-- Description Précise -->
        <p class="text-sm sm:text-base text-slate-400 max-w-3xl mx-auto leading-relaxed mb-8">
          Suite de protection web open-source pour l'auto-hébergement, les infrastructures critiques et les serveurs souverains. 
          Filtrage HTTP Zero-Trust ultra-rapide (<span class="text-emerald-400 font-mono font-bold tabular-nums">&lt; 1.5 ms</span>), blocage d'exfiltration DNS par IA locale Nimble 9B et télémétrie matérielle directe en Joules (RAPL).
        </p>

        <!-- Boutons d'Action Principaux -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-xl mx-auto font-mono text-xs font-semibold mb-10">
          <a 
            href="/fr/login/" 
            class="w-full sm:w-auto px-5 py-2.5 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold transition-colors flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
            </svg>
            <span>Accéder au Cockpit SOC</span>
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>

          <a 
            href="/docs/" 
            class="w-full sm:w-auto px-5 py-2.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-200 hover:text-white border border-slate-700 hover:border-slate-600 transition-colors flex items-center justify-center gap-2 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
            </svg>
            <span>Documentation Technique</span>
          </a>

          <a 
            href="https://github.com/aivo-labs/aegis" 
            target="_blank" 
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-4 py-2.5 rounded-lg bg-slate-950 hover:bg-slate-900 text-slate-300 hover:text-emerald-300 border border-slate-800 hover:border-slate-700 flex items-center justify-center gap-2 transition-colors"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            <span>GitHub ⭐</span>
          </a>
        </div>

        <!-- Terminal Quickstart Précis -->
        <div class="max-w-2xl mx-auto rounded-lg bg-slate-950/90 border border-slate-800 p-3.5 text-left font-mono text-xs shadow-md">
          <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-800/80 text-slate-500 text-[11px]">
            <span class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-slate-700 inline-block"></span>
              <span class="font-semibold text-slate-400">Quickstart Mono-Serveur · Docker Compose</span>
            </span>
            <span class="text-[10px] text-emerald-400 font-semibold tabular-nums">Profil Frugal (&lt; 200 MB RAM)</span>
          </div>
          <div class="text-emerald-300 font-semibold select-all break-all leading-relaxed flex items-center justify-between gap-3">
            <span>git clone https://github.com/aivo-labs/aegis.git &amp;&amp; cd aegis &amp;&amp; docker compose up -d</span>
          </div>
        </div>

      </div>
    </section>

    <!-- LES 3 PILIERS DU MOTEUR AEGIS -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="text-2xl sm:text-3xl font-bold text-white mb-2 tracking-tight">
          Architecture Modulaire &amp; Découplée
        </h2>
        <p class="text-xs sm:text-sm text-slate-400 font-mono">
          Trois moteurs indépendants fonctionnant en synergie sans alourdir l'hôte.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5">
        
        <!-- CARTE 1 : AEGIS GATE -->
        <div class="p-5 rounded-lg bg-slate-900/75 border border-slate-800/90 hover:border-slate-700 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="w-8 h-8 rounded-md bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                </svg>
              </div>
              <span class="text-[10px] font-mono tabular-nums px-2 py-0.5 rounded bg-slate-950 text-emerald-400 border border-slate-800">
                Port :8000 · PEP
              </span>
            </div>
            <h3 class="text-sm font-bold text-white mb-1.5">Aegis Gate (Ingress PEP)</h3>
            <p class="text-xs text-slate-400 leading-relaxed font-sans mb-4">
              Passerelle Ingress Zero-Trust développée en Go &amp; TypeScript. Canonicalisation Unicode anti-bypass, analyse d'entropie Shannon pour détecter l'offuscation et filtrage OWASP Top 10 en moins de 1.5 ms.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-800/80 font-mono text-[11px] text-slate-300 flex items-center justify-between">
            <span class="text-emerald-400">Pure BFF Token Handler</span>
            <span class="text-slate-500 text-[10px]">__Host- Cookies</span>
          </div>
        </div>

        <!-- CARTE 2 : AEGIS EGRESS -->
        <div class="p-5 rounded-lg bg-slate-900/75 border border-slate-800/90 hover:border-slate-700 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="w-8 h-8 rounded-md bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
              </div>
              <span class="text-[10px] font-mono tabular-nums px-2 py-0.5 rounded bg-slate-950 text-cyan-400 border border-slate-800">
                Port :5053 · Sinkhole
              </span>
            </div>
            <h3 class="text-sm font-bold text-white mb-1.5">Aegis Egress (Passerelle DNS &amp; IA)</h3>
            <p class="text-xs text-slate-400 leading-relaxed font-sans mb-4">
              Interception et inspection DNS en temps réel. Analyse sémantique des requêtes sortantes via modèle IA Nimble 9B local (Air-Gapped) pour bloquer les balises C2 et les canaux cachés d'exfiltration de données.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-800/80 font-mono text-[11px] text-slate-300 flex items-center justify-between">
            <span class="text-cyan-400">IA Nimble 9B Air-Gapped</span>
            <span class="text-slate-500 text-[10px]">0 jeton cloud</span>
          </div>
        </div>

        <!-- CARTE 3 : AEGIS GREEN -->
        <div class="p-5 rounded-lg bg-slate-900/75 border border-slate-800/90 hover:border-slate-700 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <div class="w-8 h-8 rounded-md bg-teal-500/10 border border-teal-500/30 flex items-center justify-center text-teal-400">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="4" y="4" width="16" height="16" rx="2"/>
                  <rect x="9" y="9" width="6" height="6"/>
                  <line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/>
                  <line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/>
                  <line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/>
                  <line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/>
                </svg>
              </div>
              <span class="text-[10px] font-mono tabular-nums px-2 py-0.5 rounded bg-slate-950 text-teal-400 border border-slate-800">
                Agent Rust · RAPL
              </span>
            </div>
            <h3 class="text-sm font-bold text-white mb-1.5">Aegis Green (Télémétrie Matérielle)</h3>
            <p class="text-xs text-slate-400 leading-relaxed font-sans mb-4">
              Agent de télémétrie Rust interrogeant directement les registres processeurs Intel/AMD RAPL via Scaphandre. Mesure précise de la consommation électrique brute en Joules/Watts et bilan ESG opposable RGESN.
            </p>
          </div>
          <div class="pt-3 border-t border-slate-800/80 font-mono text-[11px] text-slate-300 flex items-center justify-between">
            <span class="text-teal-400">Mesure RAPL physique</span>
            <span class="text-slate-500 text-[10px]">RGESN · EFRAG</span>
          </div>
        </div>

      </div>
    </section>

    <!-- ENCADRÉ VERSION CLOUD / MANAGED -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
      <div class="p-5 sm:p-6 rounded-lg bg-slate-900/75 border border-slate-800/90 flex flex-col sm:flex-row items-center justify-between gap-5">
        <div class="space-y-1 text-left">
          <div class="text-[11px] font-mono text-emerald-400 font-semibold uppercase tracking-wider">OFFRE ENTREPRISE &amp; INFRASTRUCTURE CRITIQUE</div>
          <h3 class="text-base sm:text-lg font-bold text-white">Découvrez l'Offre Managée Aegis Cloud</h3>
          <p class="text-xs text-slate-400 font-sans max-w-xl">
            Scans d'intrusion automatisés, procédures de remédiation assistées et hébergement souverain managé sur serveurs certifiés avec support SecOps 24/7.
          </p>
        </div>
        <a 
          href="https://aegis.aivo.fr" 
          target="_blank" 
          rel="noopener noreferrer"
          class="shrink-0 px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 hover:text-white font-mono text-xs font-semibold transition-colors flex items-center gap-2"
        >
          <span>Visiter aegis.aivo.fr</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      </div>
    </section>

  </main>
</Layout>
